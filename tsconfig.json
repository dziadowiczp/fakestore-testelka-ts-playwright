{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist"
  },
"include": [
  "tests/**/*.ts",
  "pages/**/*.ts",
  "data/**/*.ts",
  "playwright.config.ts"
]
}
  